# =============================================================================
# DataGate VPN host — copy to site.env and fill YOUR values
#   cp site.env.example site.env
#   nano site.env          # replace every YOUR_* / example.com / CHANGE_ME
#   sudo ./scripts/install-vpn-host.sh
# =============================================================================

# --- identity ---
PUBLIC_IP=YOUR_PUBLIC_IP
# Set at install; used for certs/DNS checks. Xray announce uses XRAY_DOMAIN (+ :9443) without extra PUBLIC_API_URL.
# Leave empty to auto-detect from default route
WAN_IF=
INSTALL_HOME=/home/YOUR_LINUX_USER
# Stacks: openvpn-tcp-wss/, openvpn-udp-wss/, pi-hole/, nginx-docker/, …
CERTBOT_EMAIL=you@yourdomain.com

# --- OpenVPN WSS domains (must have DNS A → PUBLIC_IP before certbot) ---
UDP_WSS_DOMAIN=your-udp.yourdomain.com
TCP_WSS_DOMAIN=your-tcp.yourdomain.com
# optional ACME/helper host (leave empty to skip)
HFS_DOMAIN=

# --- Dashboard / backend ---
BACKEND__BASEURL=https://api.datagateapp.com/
# Optional: public URL of this node's manager API (HTTPS via nginx, etc.).
# When set, managers POST it as ApiUrl on discover. Otherwise Xray uses https://XRAY_DOMAIN:XRAY_API_HTTPS_PORT/
# PUBLIC_API_URL=https://your-node-api.yourdomain.com:9443/
# Public IP of the dashboard host (UFW allow-list for OpenVPN APIs)
DASHBOARD_API_IP=YOUR_DASHBOARD_PUBLIC_IP

# --- Admin access (UFW) ---
# MUST be a real IPv4. Wrong value can lock SSH. Installer also allows your current SSH IP.
ADMIN_SSH_IP=YOUR_OFFICE_OR_HOME_IP
PROMETHEUS_IP=
NODE_EXPORTER_PORT=9100
DOCKER_BRIDGE_CIDR=172.17.0.0/16

# --- VPN subnets (unique per host; installer sets DNS to TCP .1 automatically) ---
TCP_VPN_SUBNET=10.51.40.0
UDP_VPN_SUBNET=10.51.42.0
# Overwritten from TCP_VPN_SUBNET at install + post-install-check (stale example value is ignored):
TCP_DNS1=10.51.40.1
TCP_DNS2=10.51.40.1
UDP_DNS1=10.51.40.1
UDP_DNS2=10.51.40.1
PIHOLE_DNS_IP=10.51.40.1

# --- ports (defaults match reference hosts) ---
TCP_PORT=1297
UDP_PORT=1194
TCP_API_PORT=5011
UDP_API_PORT=5010
TCP_MANAGEMENT_PORT=5097
UDP_MANAGEMENT_PORT=5096

# --- tun device names (keep stable; used by UFW + Pi-hole) ---
TCP_TUN_DEV=tun-tcp
UDP_TUN_DEV=ovpn-udp
UDP_WAN_IF=

# --- Pi-hole ---
PIHOLE_WEBPASSWORD=CHANGE_ME
PIHOLE_WEB_PORT=8080
TZ=UTC

# --- OpenVPN ---
ASPNETCORE_ENVIRONMENT=Production
# DCO needs host kernel module (ovpn / ovpn-dco). Installer auto-picks cipher:
# AES-128-GCM if CPU has AES-NI, else CHACHA20-POLY1305.
TCP_DCO=true
UDP_DCO=true
TCP_CIPHER=AES-128-GCM
TCP_DATA_CIPHERS=AES-128-GCM:CHACHA20-POLY1305
UDP_CIPHER=AES-128-GCM
UDP_DATA_CIPHERS=AES-128-GCM:CHACHA20-POLY1305
TCP_VPN_NETMASK=255.255.255.0
UDP_VPN_NETMASK=255.255.255.0

# --- installer toggles (true/false) ---
INSTALL_DOCKER=true
SETUP_UFW=true
ISSUE_CERTS=true
START_STACKS=true
# Full stack like dg-telegrambot / hel / pol: set true and fill XRAY_* below
INSTALL_XRAY=true

# --- Xray (required when INSTALL_XRAY=true) ---
XRAY_DOMAIN=your-xray.yourdomain.com
XRAY_MANAGER_HOST_PORT=5012
XRAY_API_HTTPS_PORT=9443
# Comma-separated IPs allowed on :9443 (dashboard, monitoring)
XRAY_API_ALLOW_IPS=YOUR_DASHBOARD_PUBLIC_IP
XRAY_TRANSPORT_MODE=tls
XRAY_ACCEPT_PROXY_PROTOCOL=true
# Second VLESS inbound over xHTTP, on its own port with its own TLS (no nginx in front).
# Purpose: HTTP/2 request-response shape off :443, since Russian DPI polices TLS connections on
# :443 and fingerprints steady tunnels. The inbound on :443 stays untouched — this is an addition.
# Port must be free on the host (8443 is taken by nginx) and not equal to 443.
XRAY_XHTTP_ENABLED=true
XRAY_XHTTP_PORT=2053
XRAY_XHTTP_PATH=/api/v1/update
XRAY_XHTTP_MODE=auto
# Which inbound issued client profiles point at: primary | xhttp. Requires XRAY_XHTTP_ENABLED=true for
# 'xhttp'. Profiles are re-rendered when an app downloads them, so switching this and recreating the
# xray container moves the node's existing users to the other transport on their next connect.
XRAY_CLIENT_LINK_TRANSPORT=primary
XRAY_HOST_GATEWAY=172.17.0.1
# DNS/Pi-hole URLs — installer ALWAYS overwrites from TCP_VPN_SUBNET (.1) + identity subnet
XRAY_DNS1=
XRAY_DNS2=
XRAY_PIHOLE_BASE_URL=
# Unique per host — never reuse another node's range (change for each new VPS)
XRAY_DNS_IDENTITY_ENABLED=true
XRAY_DNS_IDENTITY_SUBNET=10.80.1.0/24
# Forced to eth0 at install (container iface — never host WAN)
XRAY_DNS_IDENTITY_IFACE=eth0
XRAY_PIHOLE_CLIENT_SUBNET_PREFIX=
XRAY_PIHOLE_EXCLUDE_PREFIXES=
# Filled automatically if empty; must match INSTALL_HOME
NGINX_CERTBOT_CONF=
