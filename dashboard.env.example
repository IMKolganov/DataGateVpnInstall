# =============================================================================
# DataGate dashboard host — copy to dashboard.env and fill YOUR values
#   cp dashboard.env.example dashboard.env
#   nano dashboard.env     # replace every YOUR_* / example.com / CHANGE_ME
#   sudo ./scripts/install-dashboard-host.sh --env /dev/shm/dashboard.env --prepare-only --tang-bundle-dir /dev/shm/service-dg-dashboard
#   sudo ./scripts/install-dashboard-host.sh --env /dev/shm/dashboard.env --deploy-only
# See DASHBOARD.md. This is a TRUSTED Bash file; single-quote secrets containing $, spaces, # or quotes.
#
# Stacks (same as the old dg-dashboard):
#   datagate-monitor/              backend + frontend + redis (dashboard + public API)
#   datagate-monitor-telegrambot/  Telegram bot (webhook behind nginx)
#   datagate-landing/              landing site (built from git)
#   nginx-docker/                  nginx :80/:443 + certbot (one Let's Encrypt cert per domain)
# =============================================================================

# --- identity ---
PUBLIC_IP=YOUR_PUBLIC_IP
# tang-gate data partition (LUKS2 + clevis) is mounted here; stacks and their secrets live on it.
INSTALL_HOME=/srv/data/datagate
DATA_DEVICE=/dev/disk/by-partlabel/dgsc-data
# A separate empty cloud disk, e.g. /dev/vdb, also works. The root disk is NEVER resized by this installer.
# DATA_RECOVERY_FILE=/dev/shm/data-recovery  # optional; otherwise tang-gate shows an offline recovery phrase
CERTBOT_EMAIL=you@yourdomain.com

# --- domains (DNS A → PUBLIC_IP before certbot) ---
# Landing: first one is the cert name, the rest are aliases on the same cert.
LANDING_DOMAINS="datagateapp.com www.datagateapp.com"
# Dashboard UI (same-origin /api). Use the SAME value as API_DOMAIN for one combined hostname.
DASHBOARD_DOMAIN=dash.datagateapp.com
# Public API (VPN hosts use BACKEND__BASEURL=https://API_DOMAIN/)
API_DOMAIN=api.datagateapp.com
# Telegram webhook; leave empty to skip the bot
TG_DOMAIN=tg.datagateapp.com

# --- admin access ---
# MUST be a real IPv4. Wrong value can lock SSH. Installer also allows your current SSH IP.
ADMIN_SSH_IP=YOUR_OFFICE_OR_HOME_IP

# --- hardening (setup-observability.sh: admin user key + TOTP, console, node_exporter, Wazuh) ---
ADMIN_USER=YOUR_LINUX_USER
# Optional input files; without them, passwords + authenticator QR are requested interactively.
# Original files are kept; temporary copies consumed by the VPN scripts live only in /dev/shm.
# ADMIN_PUBKEY_FILE=/dev/shm/admin.pub
# ADMIN_PASSWORD_FILE=/dev/shm/admin-password
# ADMIN_TOTP_SECRET_FILE=/dev/shm/admin-totp
# GRUB_PASSWORD_FILE=/dev/shm/grub-password
# WAZUH_PASSWORD_FILE=/dev/shm/wazuh-enrollment
WAZUH_MANAGER=YOUR_WAZUH_MANAGER_IP
WAZUH_AGENT_NAME=dg-dashboard
WAZUH_VERSION=4.14.5
NODE_EXPORTER_VERSION=1.8.2
PROMETHEUS_IP=YOUR_PROMETHEUS_IP
NODE_EXPORTER_PORT=9100

# --- backend (datagate-monitor) ---
ASPNETCORE_ENVIRONMENT=Production
# Postgres lives on dg-pg-database: allow the NEW PUBLIC_IP there (UFW + pg_hba) before install.
DB_CONNECTION_STRING_DATAGATE='Host=YOUR_DB_HOST;Port=5432;Database=datagate_backend;Username=backend_user;Password=CHANGE_ME'
# A new value logs every user out (old tokens stop validating).
JWT_SECRET=CHANGE_ME_LONG_RANDOM
# If the existing DB has refresh tokens, preserve the previous pepper as well.
Jwt__RefreshPepper=CHANGE_ME_LONG_RANDOM_REFRESH_PEPPER
Auth__PublicWebBaseUrl=https://dash.datagateapp.com
Auth__TvLoginSessionMinutes=5
ELASTIC_URI=
ELASTIC_USERNAME=
ELASTIC_PASSWORD=
EmailSender__Provider=smtp
EmailSender__FromEmail=noreply@datagateapp.com
EmailSender__FromName=DataGate
EmailSender__ResendApiKey=
EmailSender__Host=CHANGE_ME
EmailSender__Port=587
EmailSender__UseSsl=true
EmailSender__Username=CHANGE_ME
EmailSender__Password=CHANGE_ME
VITE_CARTO_API_KEY=
# Optional OAuth (set backend + frontend to the same web client ID when used).
GoogleAuth__ClientId=
GoogleAuth__ClientSecret=
GoogleAuth__IosClientId=
GoogleAuth__DesktopClientId=
GoogleAuth__DesktopClientSecret=
VITE_GOOGLE_CLIENT_ID=

# --- telegram bot (only when TG_DOMAIN is set) ---
TELEGRAMBOT_BOT_TOKEN=CHANGE_ME
DASHBOARDAPI_CLIENTID=CHANGE_ME
DASHBOARDAPI_CLIENTSECRET=CHANGE_ME
TELEGRAM_REQUIRED_CHANNEL_USERNAME=DataGateVPNBot
TELEGRAM_BOT_USERNAME=DataGateVPNBot
# CRYPTOPAY_API_TOKEN=
# CRYPTOPAY_ENABLED=false
# CRYPTOPAY_USE_TESTNET=false
# STARS_ENABLED=false

# --- landing ---
LANDING_GIT_URL=https://github.com/IMKolganov/datagate-landing.git
LANDING_GIT_REF=main
# Empty LANDING_DOMAINS skips landing. Empty TG_DOMAIN plus empty bot credentials skips Telegram.
# Images can be pinned to a known release/digest before production installation.
BACKEND_IMAGE=imkolganov/datagate-monitor-backend:latest
FRONTEND_IMAGE=imkolganov/datagate-monitor-frontend:latest
BOT_IMAGE=imkolganov/datagate-monitor-telegrambot:latest
REDIS_IMAGE=redis:7-alpine
NGINX_IMAGE=nginx:stable-alpine
CERTBOT_IMAGE=certbot/certbot:latest
